#!/bin/bash
# ============================================================
#  図面取得 偵察テスト（無課金）
#  ブラウザを表示し、REINSにログイン→物件番号検索の画面を捕捉します。
#  図面のダウンロードはしません（課金なし）。
#  実行後、logs/zumen_debug/ のスクショを開発担当（Claude）に確認してもらってください。
# ============================================================
cd "$(dirname "$0")" || exit 1
PY="$(command -v python3 || echo /usr/bin/python3)"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo " 図面取得の偵察テスト（無課金）"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "ブラウザが開き、REINSにログインして物件番号検索の画面を撮影します。"
echo "図面のダウンロードはしません。"
echo ""

"$PY" zumen_download.py --explore 100139591530 --headed

echo ""
echo "✅ 偵察おわり。 logs/zumen_debug/ に画像とテキストが保存されました。"
read -p "Enterで閉じます…"
